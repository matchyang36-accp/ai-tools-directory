{
  "name": "ai-tools-directory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pages:build": "npx @cloudflare/next-on-pages",
    "cf:dev": "npx wrangler pages dev .vercel/output/static",
    "deploy": "npm run build && npm run pages:build && npx wrangler pages deploy",
    "db:migrate:local": "npx wrangler d1 migrations apply ai-tools-directory --local",
    "db:seed:local": "npx tsx scripts/seed.ts && npx wrangler d1 execute ai-tools-directory --local --file=scripts/seed.sql",
    "db:seed:gen": "npx tsx scripts/seed.ts"
  },
  "dependencies": {
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "1.12.0",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.39",
    "tailwindcss": "3.4.10",
    "tsx": "^4.19.2",
    "typescript": "5.5.3",
    "vercel": "^58.8.0",
    "wrangler": "^3.99.0"
  }
}
